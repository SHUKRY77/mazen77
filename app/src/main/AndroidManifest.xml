<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"

    >
    
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.USE_CREDENTIALS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application 
        android:allowBackup="false" 
        android:icon="@drawable/ic_app_icona"
        android:label="@string/app" 
        android:name="app.ovpnudp.developer.activities.OpenVPNApplication"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme">
        <uses-library 
            android:name="org.apache.http.legacy" 
            android:required="false" />
        <service android:name="app.ovpnudp.developer.service.OpenVPNService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <service
            android:name="app.ovpnudp.developer.service.InjectorService"
            android:exported="true"/>
        <service
            android:name="app.ovpnudp.developer.service.SocksDNSService"
            android:exported="true"/>
        <activity
            android:windowSoftInputMode="stateHidden|adjustPan"
            android:name="app.ovpnudp.developer.activities.SpashActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:exported="true"
            android:name="app.ovpnudp.developer.core.MainReceiver">
            <intent-filter>
                <action
                    android:name="app.sylnetdev.jhinuk.vpn.pro.vpn.core.MainReceiver.ACTION_SERVICE_STOP">
                </action>
                <action
                    android:name="app.sylnetdev.jhinuk.vpn.pro.vpn.core.MainReceiver.ACTION_SERVICE_RESTART">
                </action>
            </intent-filter>
        </receiver>
        <activity
            android:windowSoftInputMode="stateHidden|adjustPan"
            android:name="app.ovpnudp.developer.activities.OpenVPNClient"
            android:theme="@style/AppTheme.NoActionBar"
            android:launchMode="singleTask"
            android:exported="true"/>
		<activity
            android:windowSoftInputMode="stateHidden|adjustPan"
            android:name="app.ovpnudp.developer.activities.SelectNetworkActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="true"/>
        <receiver android:name="net.openvpn.openvpn.OpenVPNRebootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        
        <activity android:name="app.ovpnudp.developer.activities.OpenVPNPrefs"
            android:exported="true"/>

        <activity android:name="app.ovpnudp.developer.activities.FileDialog" android:exported="true"/>
        <activity android:name="app.ovpnudp.developer.activities.OpenVPNAbout" android:exported="true"/>
        <activity android:exported="true" 
            android:name="app.ovpnudp.developer.activities.OpenVPNDisconnect"
            android:theme="@android:style/Theme.NoDisplay" />
        <activity
            android:name="app.ovpnudp.developer.activities.LogActivity"
            android:label="Logs"
            android:parentActivityName="app.ovpnudp.developer.activities.OpenVPNClient"
            android:exported="true"/>
            <activity
                android:name="app.ovpnudp.developer.activities.ExceptionActivity"
                android:label="Application Error"
                android:exported="true"/>
        <activity
            android:name="app.ovpnudp.developer.activities.ResellerPanelActivity"
            android:label="Panel"
            android:parentActivityName="app.ovpnudp.developer.activities.OpenVPNClient"
            android:exported="true"/>
        <service
            android:name="app.ovpnudp.developer.service.vpn.TunnelVpnService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService"/>
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-2122970527460050~2644169580"/>
    </application>
</manifest>

