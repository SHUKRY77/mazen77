								<View
									android:background="@drawable/line_start_color_bg"
									android:layout_width="match_parent"
									android:layout_height="1dp"
									android:layout_weight="1.0" />
								<View
									android:background="@drawable/line_end_color_bg"
									android:layout_width="match_parent"
									android:layout_height="1dp"
