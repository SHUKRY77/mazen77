							android:gravity="center"
							android:id="@+id/check_update"
							android:background="@drawable/update_btn_bg"
							android:paddingLeft="20dp"
							android:paddingRight="20dp"
							android:layout_width="wrap_content"
							android:layout_height="match_parent"
							android:layout_marginLeft="10dp"
							android:text="Check update"
							style="@style/MainTextView" />
					</LinearLayout>
				</LinearLayout>
			</RelativeLayout>
		</ScrollView>
		<LinearLayout
			android:gravity="center"
			android:orientation="horizontal"
			android:visibility="gone"
			android:layout_width="match_parent"
			android:layout_height="55dp"
			android:layout_alignParentBottom="true">
			<LinearLayout
				android:gravity="center"
				android:orientation="vertical"
				android:id="@+id/b_update"
				android:background="@drawable/rlb_card_top_shape"
				android:layout_width="match_parent"
				android:layout_height="55dp"
				android:layout_weight="1.0">
				<ImageView
					android:layout_width="25dp"
					android:layout_height="25dp"
					android:src="@drawable/ic_box_download"
					app:tint="@color/accent_color" />
				<TextView
					android:textColor="#FF000000"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Update" />
			</LinearLayout>
			<LinearLayout
				android:gravity="center"
				android:orientation="vertical"
				android:id="@+id/b_tweaks"
				android:background="@drawable/rlb_card_top_shape"
				android:layout_width="match_parent"
				android:layout_height="55dp"
				android:layout_weight="1.0">
				<ImageView
					android:layout_width="25dp"
					android:layout_height="25dp"
					android:src="@drawable/tweakers"
					app:tint="@color/accent_color" />
				<TextView
					android:textColor="#FF000000"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Tweaks" />
			</LinearLayout>
			<LinearLayout
				android:gravity="center"
				android:orientation="vertical"
				android:id="@+id/b_exit"
				android:background="@drawable/rlb_card_top_shape"
				android:layout_width="match_parent"
				android:layout_height="55dp"
				android:layout_weight="1.0">
				<ImageView
					android:layout_width="25dp"
					android:layout_height="25dp"
					android:src="@drawable/ic_info"
					app:tint="@color/accent_color" />
				<TextView
					android:textColor="#FF000000"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="About" />
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>
</LinearLayout>