<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="10dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dialog_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D32F2F"
            android:padding="16dp"
            android:text="Choose your favorite color"
            android:textColor="@android:color/white"
            android:textSize="20sp" />

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:buttonTint="#D32F2F"
                android:checked="true"
                android:text="Light mod"
                android:textColor="#333333" />

            <RadioButton
                android:id="@+id/rb_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#D32F2F"
                android:text="Dark mod"
                android:textColor="#333333" />
        </RadioGroup>

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="15dp"
            android:columnCount="4"
            android:useDefaultMargins="true">

            <androidx.cardview.widget.CardView android:id="@+id/color_1" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" app:cardBackgroundColor="#F44336" app:cardCornerRadius="20dp" app:cardElevation="0dp"/>
            <androidx.cardview.widget.CardView android:id="@+id/color_2" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" app:cardBackgroundColor="#E91E63" app:cardCornerRadius="20dp" app:cardElevation="0dp"/>
            <androidx.cardview.widget.CardView android:id="@+id/color_3" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" app:cardBackgroundColor="#9C27B0" app:cardCornerRadius="20dp" app:cardElevation="0dp"/>
            <androidx.cardview.widget.CardView android:id="@+id/color_4" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" app:cardBackgroundColor="#673AB7" app:cardCornerRadius="20dp" app:cardElevation="0dp"/>

            <androidx.cardview.widget.CardView android:id="@+id/color_5" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" app:cardBackgroundColor="#3F51B5" app:cardCornerRadius="20dp" app:cardElevation="0dp"/>
            <androidx.cardview.widget.CardView android:id="@+id/color_6" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" app:cardBackgroundColor="#2196F3" app:cardCornerRadius="20dp" app:cardElevation="0dp"/>
            <androidx.cardview.widget.CardView android:id="@+id/color_7" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" app:cardBackgroundColor="#03A9F4" app:cardCornerRadius="20dp" app:cardElevation="0dp"/>
            <androidx.cardview.widget.CardView android:id="@+id/color_8" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" app:cardBackgroundColor="#00BCD4" app:cardCornerRadius="20dp" app:cardElevation="0dp"/>

            <androidx.cardview.widget.CardView android:id="@+id/color_9" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" app:cardBackgroundColor="#009688" app:cardCornerRadius="20dp" app:cardElevation="0dp"/>
            <androidx.cardview.widget.CardView android:id="@+id/color_10" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" app:cardBackgroundColor="#4CAF50" app:cardCornerRadius="20dp" app:cardElevation="0dp"/>
            <androidx.cardview.widget.CardView android:id="@+id/color_11" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" app:cardBackgroundColor="#8BC34A" app:cardCornerRadius="20dp" app:cardElevation="0dp"/>
            <androidx.cardview.widget.CardView android:id="@+id/color_12" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" app:cardBackgroundColor="#CDDC39" app:cardCornerRadius="20dp" app:cardElevation="0dp"/>

            <androidx.cardview.widget.CardView android:id="@+id/color_13" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" app:cardBackgroundColor="#FFEB3B" app:cardCornerRadius="20dp" app:cardElevation="0dp"/>
            <androidx.cardview.widget.CardView android:id="@+id/color_14" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" app:cardBackgroundColor="#FFC107" app:cardCornerRadius="20dp" app:cardElevation="0dp"/>
            <androidx.cardview.widget.CardView android:id="@+id/color_15" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" app:cardBackgroundColor="#FF9800" app:cardCornerRadius="20dp" app:cardElevation="0dp"/>
            <androidx.cardview.widget.CardView android:id="@+id/color_16" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" app:cardBackgroundColor="#FF5722" app:cardCornerRadius="20dp" app:cardElevation="0dp"/>

            <androidx.cardview.widget.CardView android:id="@+id/color_17" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" app:cardBackgroundColor="#795548" app:cardCornerRadius="20dp" app:cardElevation="0dp"/>
            <androidx.cardview.widget.CardView android:id="@+id/color_18" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" app:cardBackgroundColor="#9E9E9E" app:cardCornerRadius="20dp" app:cardElevation="0dp"/>
            <androidx.cardview.widget.CardView android:id="@+id/color_19" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" app:cardBackgroundColor="#607D8B" app:cardCornerRadius="20dp" app:cardElevation="0dp"/>
        </GridLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="20dp">

            <TextView
                android:id="@+id/btn_back_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:text="Back"
                android:textColor="#D32F2F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_apply_color"
                android:layout_width="120dp"
                android:layout_height="50dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:backgroundTint="#D32F2F"
                android:text="Apply"
                android:textColor="@android:color/white"
                app:cornerRadius="25dp" />
        </RelativeLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
