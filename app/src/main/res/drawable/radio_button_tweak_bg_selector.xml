<?xml version="1.0" encoding="utf-8"?>
	<selector
		xmlns:android="http://schemas.android.com/apk/res/android">
		<item
			android:state_checked="true">
			<shape
				xmlns:android="http://schemas.android.com/apk/res/android">
				<solid
					android:color="?attr/colorPrimaryDark"/>

				<padding
					android:left="7dp"
					android:right="7dp"
					android:bottom="7dp"
					android:top="7dp"/>
				<corners
					android:radius="25dp"/>
				<stroke
					android:width="1dp"
					android:color="#FF000000"/>


			</shape>
		</item>
		<item
			android:state_checked="false">
			<shape
				xmlns:android="http://schemas.android.com/apk/res/android">
				<solid
					android:color="#FFFFFFFF"/>

				<padding
					android:left="7dp"
					android:right="7dp"
					android:bottom="7dp"
					android:top="7dp"/>
				<corners
					android:radius="25dp"/>
				<stroke
					android:width="1dp"
					android:color="#FF000000"/>


			</shape>
		</item>
	</selector>
